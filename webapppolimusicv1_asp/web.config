<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="index.asp" /></files>
    </defaultDocument>
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".sql" /><add fileExtension=".sql" allowed="false" />
          <remove fileExtension=".md" /><add fileExtension=".md" allowed="false" />
        </fileExtensions>
        <hiddenSegments><add segment="includes" /><add segment="tools" /></hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
