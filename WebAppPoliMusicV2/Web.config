<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!--50MB=50MB*1024KB*1024B-->
		<add key="maxSongLength" value="52428800"/>
		<add key="albumImagePath" value="~/albumImages/"/>
		<add key="artistImagePath" value="~/artistImages/"/>
		<add key="userPhotoPath" value="~/userImages/"/>
		<add key="songFolderPath" value="~/SongFiles/"/>
		<add key="playlistFolderPath" value="~/playlistImages/"/>
	</appSettings>
	<connectionStrings configSource="ConnectionStrings.config" />
	<system.web>
		<globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="es-EC" uiCulture="es"/>
		<compilation debug="true"/>
		<!--51 MB para admitir el MP3 de 50 MB y el formulario multipart.-->
		<httpRuntime maxRequestLength="52224"/>
		<authentication mode="Forms">
			<forms loginUrl="Login.aspx" defaultUrl="Default.aspx" timeout="20"/>
		</authentication>
		<authorization>
			<deny users="?"/>
		</authorization>
		<pages/>
	</system.web>
	<location path="SignUp.aspx">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>
	<location path="songFiles">
		<system.web>
			<httpRuntime maxRequestLength="52224"/>
		</system.web>
	</location>
	<system.webServer>
		<security>
			<requestFiltering>
				<!--51 MB incluyendo los campos del formulario.-->
				<requestLimits maxAllowedContentLength="53477376"/>
			</requestFiltering>
		</security>
	</system.webServer>
</configuration>
